# Cloud Database URL (Neon PostgreSQL, Supabase, or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Next.js Application Public URL (e.g. https://your-domain.vercel.app)
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Session Security Secret (use at least 32 random characters in production)
JWT_SECRET="super-secret-random-key-change-this-in-production"
SESSION_SECRET="super-secret-random-key-change-this-in-production"

# Vercel Blob CDN Storage (Optional locally; required on Vercel for >2MB images & direct video uploads)
BLOB_READ_WRITE_TOKEN=""
